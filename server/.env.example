OPENAI_API_KEY=sk-your-key-here
DATABASE_URL=sqlite+aiosqlite:///./copilot.db

# --- HTTP / CORS（浏览器来源；扩展使用 chrome-extension://，见 main.py 默认正则）---
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# CORS_ALLOW_ORIGIN_REGEX=chrome-extension://[\w-]+
# API_VERSION=1

# --- Prompt 版本（对应 server/prompts/<name>.txt）---
# PROMPT_VERSION_REWRITE=rewrite_v1
# PROMPT_VERSION_EXPLAIN=explain_v1

# --- LLM 多厂商（可选；不配则等价于 LLM_PROVIDER=openai + OPENAI_API_KEY）---
# LLM_PROVIDER=openai | deepseek | anthropic | kimi | moonshot | openai_compatible
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# openai_compatible / 部分网关若不支持 JSON mode，可关闭： LLM_JSON_RESPONSE_FORMAT=0
